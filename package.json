{
  "name": "valor360",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/pwa-release.mjs stamp && node scripts/pwa-release.mjs verify",
    "bundle:audit": "node scripts/bundle-audit.mjs",
    "performance:golden:local": "node scripts/val-golden-performance-local.mjs",
    "performance:slo:check": "node scripts/val-performance-slo-check.mjs",
    "performance:conversational-os:local": "node scripts/val-conversational-os-performance-local.mjs",
    "voice:golden": "node scripts/val-voice-golden.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/start.js",
    "test": "node --test",
    "test:phase2:smoke": "node scripts/phase2-smoke.mjs",
    "test:phase5:smoke": "node scripts/phase5-smoke.mjs",
    "test:phase6:smoke": "node scripts/phase6-smoke.mjs",
