    "pwa:verify": "node scripts/pwa-release.mjs verify"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "http-proxy": "^1.18.1",
    "lucide-react": "0.468.0",
    "openai": "^7.4.0",
