{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://val.local/contracts/v1/voice-interaction.schema.json",
  "title": "VoiceInteraction v1",
  "description": "Tenant-scoped voice capture lifecycle. Transcript content is untrusted data and candidates cannot be promoted before explicit human confirmation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "version",
    "voice_interaction_id",
    "organization_id",
    "actor_id",
    "client_id",
    "visit_id",
    "interaction_type",
    "state",
    "status",
    "audio_ref",
    "transcript_ref",
    "transcript_status",
    "duration_seconds",
    "language",
    "confirmation_status",
    "source_context",
    "transcription",
    "extraction",
    "candidates",
    "reviewed_candidates",
    "related_artifacts",
    "retry_count",
    "revision",
    "error_code",
    "error_message",
    "created_at",
    "updated_at",
    "processed_at",
    "confirmed_at",
    "cancelled_at"
  ],
  "properties": {
    "contract_version": {"const": "val.voice_interaction.v1"},
    "version": {"const": "val.voice_interaction.v1"},
    "voice_interaction_id": {"type": "string", "format": "uuid"},
    "organization_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "client_id": {"type": "string", "minLength": 1},
    "visit_id": {"type": ["string", "null"], "maxLength": 180},
    "interaction_type": {"enum": ["PRE_VISIT", "FIELD_NOTE", "POST_VISIT", "CLIENT_NOTE", "GENERAL_CONTEXT"]},
    "state": {"$ref": "#/$defs/state"},
    "status": {"$ref": "#/$defs/state"},
    "audio_ref": {"type": ["string", "null"], "maxLength": 240},
    "transcript_ref": {"type": ["string", "null"], "maxLength": 240},
    "transcript_status": {"enum": ["PENDING", "PROCESSING", "COMPLETED", "FAILED"]},
    "duration_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 900},
    "language": {"type": ["string", "null"], "maxLength": 30},
    "confirmation_status": {"enum": ["PENDING", "PENDING_REVIEW", "CONFIRMED", "REJECTED", "CANCELLED"]},
    "source_context": {"type": "object"},
    "transcription": {
      "oneOf": [
        {"type": "object", "maxProperties": 0},
        {"$ref": "#/$defs/transcription_metadata"}
      ]
    },
    "extraction": {"type": "object"},
    "candidates": {"type": "array", "items": {"$ref": "voice-candidate.schema.json"}, "maxItems": 50},
    "reviewed_candidates": {"type": "array", "items": {"$ref": "voice-candidate.schema.json"}, "maxItems": 50},
    "related_artifacts": {"type": "object"},
    "retry_count": {"type": "integer", "minimum": 0},
    "revision": {"type": "integer", "minimum": 1},
    "revision_no": {"type": "integer", "minimum": 1},
    "error_code": {"type": ["string", "null"], "maxLength": 100},
    "error_message": {"type": ["string", "null"], "maxLength": 500},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "processed_at": {"type": ["string", "null"], "format": "date-time"},
    "confirmed_at": {"type": ["string", "null"], "format": "date-time"},
    "cancelled_at": {"type": ["string", "null"], "format": "date-time"},
    "transcript": {"type": ["object", "null"]}
  },
  "$defs": {
    "state": {
      "enum": [
        "CREATED",
        "AUDIO_STORED",
        "TRANSCRIBING",
        "TRANSCRIBED",
        "EXTRACTING",
        "PENDING_REVIEW",
        "CONFIRMED",
        "REJECTED",
        "CANCELLED",
        "FAILED_TRANSCRIPTION",
        "FAILED_EXTRACTION"
      ]
    },
    "transcription_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "version", "status", "provider_reference", "language", "duration_seconds", "confidence", "error"],
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 100},
        "model": {"type": "string", "minLength": 1, "maxLength": 120},
        "version": {"type": "string", "minLength": 1, "maxLength": 120},
        "status": {"enum": ["PENDING", "PROCESSING", "COMPLETED", "FAILED"]},
        "provider_reference": {"type": ["string", "null"], "maxLength": 240},
        "language": {"type": ["string", "null"], "maxLength": 30},
        "duration_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 900},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "error": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "status", "retryable"],
              "properties": {
                "code": {"type": "string", "minLength": 1, "maxLength": 100},
                "status": {"type": ["integer", "null"]},
                "retryable": {"type": "boolean"}
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"enum": ["CONFIRMED"]}}},
      "then": {
        "properties": {
          "confirmation_status": {"const": "CONFIRMED"},
          "confirmed_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    {
      "if": {"properties": {"state": {"enum": ["CANCELLED"]}}},
      "then": {
        "properties": {
          "confirmation_status": {"const": "CANCELLED"},
          "cancelled_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  ]
}
