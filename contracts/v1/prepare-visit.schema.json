{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://val.local/contracts/v1/prepare-visit.schema.json",
  "title": "PrepareVisit v1",
  "type": "object",
  "required": ["contract_version", "version", "preparation_id", "organization_id", "visit_id", "subject_id", "context_snapshot_id", "behavioral_profile_version", "decision_thesis_id", "decision_thesis_version", "value_plan_id", "value_plan_version", "action_plan_id", "visit_type", "objective", "main_opportunity", "why_now", "profile_approach", "golden_questions", "val_thesis", "proofs_to_take", "probable_objection", "objection_guidance", "automatic_discount", "commitment_target", "priority_actions", "missing_information", "secondary_opportunities", "safety", "created_at"],
  "properties": {
    "contract_version": {"const": "val.prepare_visit.v1"},
    "version": {"const": "val.prepare_visit.v1"},
    "preparation_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string", "minLength": 1},
    "visit_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "context_snapshot_id": {"type": "string", "minLength": 1},
    "behavioral_profile_version": {"type": "string", "minLength": 1},
    "decision_thesis_id": {"type": "string", "minLength": 1},
    "decision_thesis_version": {"const": "val.decision_thesis.v1"},
    "value_plan_id": {"type": "string", "minLength": 1},
    "value_plan_version": {"const": "val.value_plan.v1"},
    "action_plan_id": {"type": "string", "minLength": 1},
    "visit_type": {"enum": ["COMMERCIAL", "TECHNICAL", "RELATIONSHIP", "PENDING_ITEM"]},
    "objective": {"type": "string", "minLength": 1},
    "main_opportunity": {"type": "object"},
    "why_now": {"type": "string", "minLength": 1},
    "profile_approach": {"type": "object"},
    "golden_questions": {"type": "array", "maxItems": 3},
    "val_thesis": {"type": "string", "minLength": 1},
    "proofs_to_take": {"type": "array"},
    "probable_objection": {"type": "string"},
    "objection_guidance": {"type": "string"},
    "automatic_discount": {"const": false},
    "commitment_target": {"type": "string", "minLength": 1},
    "priority_actions": {"type": "array", "maxItems": 3},
    "missing_information": {"type": "array"},
    "secondary_opportunities": {"type": "array"},
    "safety": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
