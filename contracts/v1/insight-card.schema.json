{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://val.local/contracts/v1/insight-card.schema.json",
  "title": "InsightCard v1",
  "type": "object",
  "required": ["contract_version", "version", "insight_id", "organization_id", "actor_id", "subject_id", "category", "priority", "title", "summary", "why_now", "recommended_action", "confidence", "epistemic_status", "evidence_refs", "expires_at", "created_at", "priority_policy_version"],
  "properties": {
    "contract_version": {"const": "val.insight_card.v1"},
    "version": {"const": "val.insight_card.v1"},
    "insight_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "category": {"enum": ["ACT_NOW", "PREPARE", "FOLLOW_UP", "LEARN"]},
    "priority": {"type": "number", "minimum": 0, "maximum": 100},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "why_now": {"type": "string", "minLength": 1},
    "recommended_action": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "epistemic_status": {"enum": ["SUPPORTED", "HYPOTHESIS"]},
    "evidence_refs": {"type": "array"},
    "expires_at": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "priority_policy_version": {"const": "val.insight_priority.experimental.v1"}
  }
}
