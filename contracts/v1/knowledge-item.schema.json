{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://val.local/contracts/v1/knowledge-item.schema.json",
  "title": "KnowledgeItem v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "knowledge_item_id", "title", "domain", "statement",
    "application_val", "triggers", "recommended_actions", "avoid",
    "module_targets", "source_refs", "authority", "risk", "geographic_scope",
    "status", "raw_status", "version", "valid_from", "valid_until",
    "review_at", "owner", "supersedes_id", "created_at", "updated_at",
    "usage_mode", "requires_human_review", "retrieval_eligible",
    "governance_reason_codes", "prompt_safety"
  ],
  "properties": {
    "contract_version": {"const": "val.knowledge_item.v1"},
    "knowledge_item_id": {"type": "string", "pattern": "^KI-[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "type": {"type": ["string", "null"]},
    "statement": {"type": "string", "minLength": 1},
    "application_val": {"type": "string", "minLength": 1},
    "triggers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "recommended_actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "avoid": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "module_targets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SRC-[0-9]{3,}$"}, "uniqueItems": true},
    "authority": {"enum": ["A", "B", "C", "D"]},
    "risk": {"enum": ["LOW", "HIGH"]},
    "geographic_scope": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "UNDER_REVIEW", "APPROVED", "REJECTED", "SUPERSEDED", "EXPIRED"]},
    "raw_status": {"type": ["string", "null"]},
    "version": {"type": "string", "minLength": 1},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "review_at": {"type": ["string", "null"], "format": "date-time"},
    "owner": {"type": ["string", "null"]},
    "supersedes_id": {"type": ["string", "null"]},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "review_cycle_days": {"type": ["integer", "null"], "minimum": 1},
    "usage_mode": {"enum": ["DECISION_SUPPORT", "GUARDRAIL_ONLY"]},
    "requires_human_review": {"type": "boolean"},
    "retrieval_eligible": {"type": "boolean"},
    "governance_reason_codes": {"type": "array", "items": {"type": "string"}},
    "prompt_safety": {"enum": ["SAFE", "BLOCKED"]}
  }
}
