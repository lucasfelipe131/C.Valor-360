{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://val.local/contracts/v1/action-plan.schema.json",
  "title": "ActionPlan v1",
  "type": "object",
  "required": ["contract_version", "version", "action_plan_id", "organization_id", "subject_id", "decision_thesis_id", "value_plan_id", "context_snapshot_id", "priorities", "created_at", "updated_at"],
  "properties": {
    "contract_version": {"const": "val.action_plan.v1"},
    "version": {"const": "val.action_plan.v1"},
    "action_plan_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "decision_thesis_id": {"type": "string", "minLength": 1},
    "value_plan_id": {"type": "string", "minLength": 1},
    "context_snapshot_id": {"type": "string", "minLength": 1},
    "priorities": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["action_id", "title", "description", "reason", "owner", "due_at", "status", "success_criteria", "evidence_required", "confidence", "source_refs", "created_at", "updated_at"],
        "properties": {
          "action_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "owner": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["type", "id"], "properties": {"type": {"enum": ["USER", "CLIENT", "EXTERNAL"]}, "id": {"type": "string", "minLength": 1}}}]},
          "due_at": {"type": ["string", "null"], "format": "date-time"},
          "status": {"enum": ["PROPOSED", "ACCEPTED", "IN_PROGRESS", "DONE", "BLOCKED", "CANCELLED"]},
          "success_criteria": {"type": "string"},
          "evidence_required": {"type": "array"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "source_refs": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}, "type": {"type": "string"}}}},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
