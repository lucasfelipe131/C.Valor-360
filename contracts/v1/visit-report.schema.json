{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://val.local/contracts/v1/visit-report.schema.json",
  "title": "VisitReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "version", "visit_report_id", "visit_id", "organization_id", "client_id", "created_by", "confirmed_by", "source_type", "source_ref", "transcript_ref", "transcript_id", "visit_objective", "summary", "discussed_topics", "expectations_created", "objections", "producer_signals", "opportunities_detected", "commitments_proposed", "commitments_confirmed", "closed_business", "pending_business", "next_steps", "technical_observations", "behavioral_signals", "missing_information", "consultant_notes", "confidence", "confirmation_status", "revision_no", "idempotency_key", "created_at", "confirmed_at"],
  "properties": {
    "contract_version": {"const": "val.visit_report.v1"},
    "version": {"const": "val.visit_report.v1"},
    "visit_report_id": {"type": "string", "format": "uuid"},
    "visit_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string", "minLength": 1},
    "client_id": {"type": "string", "minLength": 1},
    "created_by": {"type": "string", "minLength": 1},
    "confirmed_by": {"type": ["string", "null"]},
    "source_type": {"enum": ["TEXT", "AUDIO"]},
    "source_ref": {"type": "string", "minLength": 1, "maxLength": 240},
    "transcript_ref": {"type": ["string", "null"], "maxLength": 240},
    "transcript_id": {"type": ["string", "null"]},
    "visit_objective": {"type": "string", "minLength": 1, "maxLength": 1600},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1200},
    "discussed_topics": {"type": "array", "items": {"type": "string"}},
    "expectations_created": {"$ref": "#/$defs/items"},
    "objections": {"$ref": "#/$defs/items"},
    "producer_signals": {"$ref": "#/$defs/items"},
    "opportunities_detected": {"$ref": "#/$defs/items"},
    "commitments_proposed": {"$ref": "#/$defs/items"},
    "commitments_confirmed": {"$ref": "#/$defs/items"},
    "closed_business": {"$ref": "#/$defs/items"},
    "pending_business": {"$ref": "#/$defs/items"},
    "next_steps": {"$ref": "#/$defs/items"},
    "technical_observations": {"$ref": "#/$defs/items"},
    "behavioral_signals": {"$ref": "#/$defs/items"},
    "missing_information": {"$ref": "#/$defs/items"},
    "consultant_notes": {"type": "string", "maxLength": 4000},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "confirmation_status": {"enum": ["PENDING_REVIEW", "CONFIRMED", "REJECTED"]},
    "revision_no": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 180},
    "created_at": {"type": "string", "format": "date-time"},
    "confirmed_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "epistemic_status", "statement", "source_ref", "confidence", "requires_confirmation"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "epistemic_status": {"enum": ["FACT_CANDIDATE", "INFERENCE", "HYPOTHESIS"]},
          "statement": {"type": "string", "minLength": 1},
          "source_ref": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "requires_confirmation": {"const": true}
        }
      }
    }
  }
}
