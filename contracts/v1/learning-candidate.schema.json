{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://val.local/contracts/v1/learning-candidate.schema.json",
  "title": "LearningCandidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "version", "candidate_id", "organization_id", "source_visit_id", "source_visit_report_id", "source_outcome_id", "hypothesis", "scope", "supporting_evidence", "contrary_evidence", "confidence", "status", "created_by", "created_at"],
  "properties": {
    "contract_version": {"const": "val.learning_candidate.v1"},
    "version": {"const": "val.learning_candidate.v1"},
    "candidate_id": {"type": "string", "format": "uuid"},
    "organization_id": {"type": "string", "minLength": 1},
    "source_visit_id": {"type": "string", "minLength": 1},
    "source_visit_report_id": {"type": ["string", "null"]},
    "source_outcome_id": {"type": ["string", "null"]},
    "hypothesis": {"type": "string", "minLength": 1},
    "scope": {"type": "object"},
    "supporting_evidence": {"type": "array", "items": {"type": "object"}},
    "contrary_evidence": {"type": "array", "items": {"type": "object"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["CANDIDATE", "UNDER_REVIEW", "APPROVED", "REJECTED", "EXPIRED"]},
    "created_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
