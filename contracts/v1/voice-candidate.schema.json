{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://val.local/contracts/v1/voice-candidate.schema.json",
  "title": "VoiceCandidate v1",
  "description": "Candidate extracted from untrusted voice transcript. Category and epistemic status are independent, and human confirmation is always required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "version",
    "candidate_id",
    "voice_interaction_id",
    "category",
    "epistemic_status",
    "statement",
    "evidence_excerpt",
    "source_ref",
    "confidence",
    "requires_confirmation",
    "review_status",
    "reviewed_by",
    "reviewed_at",
    "metadata",
    "created_at"
  ],
  "properties": {
    "contract_version": {"const": "val.voice_candidate.v1"},
    "version": {"const": "val.voice_candidate.v1"},
    "candidate_id": {"type": "string", "format": "uuid"},
    "voice_interaction_id": {"type": "string", "format": "uuid"},
    "category": {
      "enum": [
        "FACT_CANDIDATE",
        "COMMITMENT_CANDIDATE",
        "OBJECTION",
        "OPPORTUNITY_CANDIDATE",
        "BEHAVIORAL_SIGNAL",
        "AGRONOMIC_OBSERVATION",
        "EXPECTATION",
        "NEXT_STEP",
        "MISSING_INFORMATION",
        "HYPOTHESIS"
      ]
    },
    "epistemic_status": {"enum": ["FACT_CANDIDATE", "INFERENCE", "HYPOTHESIS"]},
    "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
    "evidence_excerpt": {"type": ["string", "null"], "maxLength": 800},
    "source_ref": {"type": "string", "minLength": 1, "maxLength": 240},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "requires_confirmation": {"const": true},
    "review_status": {"enum": ["PENDING", "CONFIRMED", "REJECTED"]},
    "reviewed_by": {"type": ["string", "null"], "maxLength": 180},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "due_at": {"type": ["string", "null"], "format": "date-time"},
    "metadata": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"review_status": {"enum": ["CONFIRMED", "REJECTED"]}}},
      "then": {
        "properties": {
          "reviewed_by": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  ]
}
