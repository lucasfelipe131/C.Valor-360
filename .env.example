# Nunca coloque valores reais neste arquivo ou no GitHub.
DATABASE_URL=
AUTO_MIGRATE=false
VAL_DEMO_MODE=false

# Crie uma chave de projeto exclusiva para o VALOR 360 e salve como segredo na Railway.
OPENAI_API_KEY=
OPENAI_PROJECT=
OPENAI_STORE_RESPONSES=false
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=1
VAL_MODEL_DAILY=gpt-5.6-terra
VAL_MODEL_STRATEGIC=gpt-5.6-sol
VAL_MODEL_FAST=gpt-5.6-luna
VAL_VOICE_TRANSCRIPTION_MODEL=gpt-transcribe
VAL_VOICE_EXTRACTION_MODEL=gpt-5.6-luna
VAL_VOICE_REQUESTS_PER_10_MINUTES=20
VAL_VOICE_MAX_DURATION_SECONDS=900
VAL_VOICE_MAX_AUDIO_BYTES=6000000
VAL_MAX_OUTPUT_TOKENS=26000
VAL_STRATEGIC_MAX_OUTPUT_TOKENS=32000
VAL_AI_REQUESTS_PER_10_MINUTES=30
VAL_LOGIN_ATTEMPTS_PER_10_MINUTES=8

# Opcional: somente materiais aprovados e não sensíveis para File Search.
VAL_KNOWLEDGE_VECTOR_STORE_ID=

# Integração servidor-servidor com o Manual do Agrônomo.
VAL_MANUAL_WEBHOOK_SECRET=
VAL_INTEGRATION_TOKEN=

# Proteção mínima do piloto. Substituir por identidade corporativa antes de múltiplos usuários.
VAL_ADMIN_EMAIL=
# Mínimo de 12 caracteres.
VAL_ADMIN_PASSWORD=
# Segredo aleatório com no mínimo 32 caracteres.
VAL_SESSION_SECRET=
VAL_SESSION_TTL_SECONDS=43200

# Produção multiempresa.
VAL_DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001
